# Copy to a local, ignored terraform.tfvars file. Never put secret inputs here.
subscription_id  = "00000000-0000-0000-0000-000000000000"
name_prefix      = "vocabtutor"
environment      = "prod"
admin_ipv4_cidr  = "8.8.8.8/32" # Replace; this is only a syntactically valid public /32 example.

# Leave false for the shared-platform bootstrap. The one-time
# azure:provision-workloads command changes the ignored local copy to true.
# Terraform then owns stable workload infrastructure but deliberately ignores
# image revisions, which are released directly through Azure Container Apps.
deploy_workloads = false

# Increment only when intentionally rotating the four Key Vault values.
# secret_rotation_version = 1

# Optional low-volume operational alert recipient:
# alert_email = "operator@example.com"
