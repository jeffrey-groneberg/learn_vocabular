{
  "name": "@vocabulary/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && tsup server/index.ts server/cleanup.ts --format esm --platform node --target node24 --out-dir dist-server --clean --no-splitting",
    "lint": "oxlint src server",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vocabulary/domain": "*",
    "@vocabulary/observability": "*",
    "fastify": "^5.12.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
