{
  "name": "@vocabulary/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsup src/index.ts --format esm --platform node --target node24 --out-dir dist --clean --no-splitting",
    "dev": "tsx watch src/index.ts",
    "lint": "oxlint src",
    "start": "node --import @azure/monitor-opentelemetry/loader dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/keyvault-secrets": "^4.11.2",
    "@opentelemetry/api": "^1.9.1",
    "@vocabulary/domain": "*",
    "@vocabulary/observability": "*",
    "fastify": "^5.12.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
