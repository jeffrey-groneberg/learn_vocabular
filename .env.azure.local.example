# Copy this file to .env.azure.local. The local file is ignored by Git.
#
# Use either the Speech endpoint directly:
# SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/
#
# Or remove SPEECH_ENDPOINT and let the launcher resolve it with Azure CLI:
# AZURE_SPEECH_RESOURCE_GROUP=your-resource-group
# AZURE_SPEECH_ACCOUNT=your-speech-resource
#
# Optional: fail if Azure CLI is signed in to a different subscription.
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

LOCAL_API_PORT=3001
LOCAL_GATEWAY_PORT=3000
LOCAL_WEB_HOST=127.0.0.1
LOCAL_WEB_PORT=5173

# Local HTTP needs a non-__Host cookie without the Secure attribute.
SESSION_COOKIE_NAME=vocabulary-voice-tutor-local
SESSION_COOKIE_SECURE=false
